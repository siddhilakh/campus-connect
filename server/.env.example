# CampusConnect Server Environment Configuration
PORT=5000
NODE_ENV=production

# Database Connection URL:
# For Local SQLite: "file:./dev.db"
# For Neon PostgreSQL: "postgresql://username:password@ep-cool-sample.us-east-2.aws.neon.tech/campusconnect?sslmode=require"
# For Local PostgreSQL: "postgresql://postgres:postgres@localhost:5432/campusconnect"
DATABASE_URL="file:./dev.db"

# JWT Secret for Session Authentication
JWT_SECRET="replace_with_a_secure_random_string_in_production"
JWT_EXPIRES_IN="7d"

# Client CORS URL (Vercel deployment or localhost)
CLIENT_URL="http://localhost:5173"
